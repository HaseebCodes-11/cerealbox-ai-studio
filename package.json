{
  "name": "cerealbox-ai-studio",
  "version": "1.0.0",
  "description": "CerealBox AI Automation & Creative Workflow Challenge - proposal, prototypes and tests for all nine areas",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx src/cli/demo.ts",
    "demo:brief": "tsx src/cli/demo.ts --brief",
    "toast": "tsx src/cli/toast.ts",
    "toast:ask": "tsx src/cli/toast.ts ask",
    "agent": "tsx src/cli/agent.ts",
    "eval": "tsx src/cli/eval.ts",
    "verify": "npm run typecheck && npm run typecheck:web && npm test && npm run demo:all && npm run reports && npm run eval && npm run web:build",
    "video": "tsx src/cli/video.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts --port 4173",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "demo:all": "tsx src/cli/demo.ts --brief samples/brief-winter-warmth.json && tsx src/cli/demo.ts --brief samples/brief-food-bank.json",
    "reports": "tsx src/cli/reports.ts"
  },
  "keywords": [
    "ai",
    "automation",
    "advertising",
    "meta-ads",
    "charity",
    "fundraising"
  ],
  "author": "Haseeb Metla",
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  }
}
