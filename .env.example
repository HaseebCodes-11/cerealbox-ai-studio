# Which LLM backend to use. "mock" is deterministic and needs no network or key.
# "anthropic" calls Claude via the official SDK (needs ANTHROPIC_API_KEY or `ant auth login`).
LLM_PROVIDER=mock

# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional model routing by task effort (unset = every task uses ANTHROPIC_MODEL).
# e.g. ANTHROPIC_MODEL_LOW=claude-haiku-5-5 runs classification/narration tasks ~40x cheaper.
ANTHROPIC_MODEL_LOW=
ANTHROPIC_MODEL_MEDIUM=
ANTHROPIC_MODEL_HIGH=

# Optional: where demo outputs are written
OUT_DIR=out

# Supabase Edge Functions (set with `supabase secrets set`, not in this file):
#   FUNCTIONS_SHARED_SECRET  bearer token n8n / pg_cron / True ROAS present when calling the functions
#   META_ACCESS_TOKEN        Meta Marketing API token used by ads-agent-execute
# and in Postgres: alter database postgres set app.functions_secret = '<same value>';
